--- /dev/null
+++ b/dl/base/isa/esp32p4/dl_esp32p4_leaky_formula.S
@@ -0,0 +1,117 @@
+#include "dl_esp32p4_s8.S"
+
+    .section .rodata
+    .align 4
+.L_formula_tenths_corrections:
+    .byte -115, -95, -75, -55, -35, -15
+.L_formula_twentieths_corrections:
+    .byte -110, -70, -30
+.L_formula_fiftieths_corrections:
+    .byte -75
+
+    .macro load_broadcast_s16 output, value, temporary
+        slli             \temporary, \value, 16
+        or               \temporary, \temporary, \value
+        esp.movi.32.q    \output, \temporary, 0
+        esp.movi.32.q    \output, \temporary, 1
+        esp.movi.32.q    \output, \temporary, 2
+        esp.movi.32.q    \output, \temporary, 3
+    .endm
+
+    .macro leaky_formula_block correction_count
+        esp.vld.128.ip       q7, a1, 16
+        esp.vext.s8          q0, q1, q7
+
+        esp.zero.qacc
+        esp.vmulas.s16.qacc  q0, q2
+        esp.srcmb.s8.qacc    q3, a4, 1
+        esp.zero.qacc
+        esp.vmulas.s16.qacc  q1, q2
+        esp.srcmb.s8.qacc    q5, a4, 1
+        esp.vunzip.8         q3, q5
+
+        esp.zero.qacc
+        esp.vmulas.s16.qacc  q0, q4
+        esp.srcmb.s8.qacc    q5, t3, 1
+        esp.zero.qacc
+        esp.vmulas.s16.qacc  q1, q4
+        esp.srcmb.s8.qacc    q6, t3, 1
+        esp.vunzip.8         q5, q6
+
+        .if \correction_count
+            esp.zero.q       q1
+            .rept \correction_count
+                esp.vldbc.8.ip   q0, t5, 1
+                esp.vcmp.eq.s8   q6, q7, q0
+                esp.orq          q1, q1, q6
+            .endr
+            addi             t5, t5, -\correction_count
+            esp.vadd.s8      q3, q3, q1
+        .endif
+
+        esp.zero.q           q0
+        esp.vcmp.lt.s8       q6, q7, q0
+        esp.andq             q3, q3, q6
+        esp.vcmp.gt.s8       q6, q7, q0
+        esp.andq             q5, q5, q6
+        esp.vadd.s8          q3, q3, q5
+        esp.vst.128.ip       q3, a0, 16
+    .endm
+
+    .text
+    .align 4
+    .global dl_esp32p4_s8_leaky_formula
+    .type dl_esp32p4_s8_leaky_formula, @function
+dl_esp32p4_s8_leaky_formula:
+    # a0 output, a1 input, a2 blocks of 16
+    # a3 negative multiplier, a4 negative shift
+    # a5 positive multiplier, a6 positive shift, a7 correction class
+    load_broadcast_s16 q2, a3, t3
+    load_broadcast_s16 q4, a5, t4
+    mv               t3, a6
+
+    beqz             a7, .L_formula_no_correction
+    li               t4, 1
+    beq              a7, t4, .L_formula_tenths
+    li               t4, 2
+    beq              a7, t4, .L_formula_twentieths
+    j                .L_formula_fiftieths
+
+.L_formula_no_correction:
+    beqz             a2, .L_formula_done
+.L_formula_no_correction_loop:
+    leaky_formula_block 0
+    addi             a2, a2, -1
+    bnez             a2, .L_formula_no_correction_loop
+    j                .L_formula_done
+
+.L_formula_tenths:
+    la               t5, .L_formula_tenths_corrections
+    beqz             a2, .L_formula_done
+.L_formula_tenths_loop:
+    leaky_formula_block 6
+    addi             a2, a2, -1
+    bnez             a2, .L_formula_tenths_loop
+    j                .L_formula_done
+
+.L_formula_twentieths:
+    la               t5, .L_formula_twentieths_corrections
+    beqz             a2, .L_formula_done
+.L_formula_twentieths_loop:
+    leaky_formula_block 3
+    addi             a2, a2, -1
+    bnez             a2, .L_formula_twentieths_loop
+    j                .L_formula_done
+
+.L_formula_fiftieths:
+    la               t5, .L_formula_fiftieths_corrections
+    beqz             a2, .L_formula_done
+.L_formula_fiftieths_loop:
+    leaky_formula_block 1
+    addi             a2, a2, -1
+    bnez             a2, .L_formula_fiftieths_loop
+
+.L_formula_done:
+    ret
+
+    .size dl_esp32p4_s8_leaky_formula, .-dl_esp32p4_s8_leaky_formula
