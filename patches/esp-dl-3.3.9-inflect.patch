+template <typename T>
+bool rewrite_divisor(TensorBase *tensor)
+{
+    static_assert(std::is_same_v<T, int8_t> || std::is_same_v<T, int16_t>);
+    const int exponent = tensor->exponent.get();
+    const double quant_scale = std::ldexp(1.0, -exponent);
+    const long long quantized_three = std::llround(3.0 * quant_scale);
+    const long long quantized_two = std::llround(2.0 * quant_scale);
+    const double value_three = std::ldexp(static_cast<double>(quantized_three), exponent);
+    const double value_two = std::ldexp(static_cast<double>(quantized_two), exponent);
+
+    if (std::abs(value_three - 3.0) > 1e-9 || std::abs(value_two - 2.0) > 1e-9 ||
+        quantized_two < std::numeric_limits<T>::min() || quantized_two > std::numeric_limits<T>::max()) {
+        return false;
+    }
+
+    T *value = tensor->get_element_ptr<T>();
+    if (*value != static_cast<T>(quantized_three) && *value != static_cast<T>(quantized_two)) {
+        return false;
+    }
+    *value = static_cast<T>(quantized_two);
+    return true;
+}
+
+bool rewrite_divisor_to_two(TensorBase *tensor)
+{
+    if (tensor == nullptr || tensor->get_size() != 1 || tensor->exponent.is_per_channel()) {
+        return false;
+    }
+    if (tensor->get_dtype() == DATA_TYPE_INT8) {
+        return rewrite_divisor<int8_t>(tensor);
+    }
+    if (tensor->get_dtype() == DATA_TYPE_INT16) {
+        return rewrite_divisor<int16_t>(tensor);
+    }
+    if (tensor->get_dtype() == DATA_TYPE_FLOAT) {
+        float *value = tensor->get_element_ptr<float>();
+        if (std::abs(*value - 3.0f) > 1e-6f && std::abs(*value - 2.0f) > 1e-6f) {
+            return false;
+        }
+        *value = 2.0f;
+        return true;
+    }
+    return false;
+}
+
+#if defined(INFLECT_RUNTIME_DIV2_REQUANT)
+bool requantize_divide_by_two(TensorBase *output, TensorBase *input, runtime_mode_t mode)
+{
+    if (output == nullptr || input == nullptr || output->get_size() != input->get_size() ||
+        output->exponent.is_per_channel() || input->exponent.is_per_channel() ||
+        (reinterpret_cast<uintptr_t>(output->get_element_ptr()) & 0xf) != 0 ||
+        (reinterpret_cast<uintptr_t>(input->get_element_ptr()) & 0xf) != 0) {
+        return false;
+    }
+
+    std::vector<base::requantizeArgsType> args = base::get_requantize_operation_args(output, input, mode);
+    if (args.size() != 1) {
+        return false;
+    }
+
+    const int effective_shift = output->exponent.get() - input->exponent.get() + 1;
+    if (effective_shift < -14 || effective_shift > 31) {
+        return false;
+    }
+    if (effective_shift < 0) {
+        args[0].output_scale = 1 << (-effective_shift);
+        args[0].output_shift = 0;
+    } else {
+        args[0].output_scale = -1;
+        args[0].output_shift = effective_shift;
+    }
+
+    if (output->get_dtype() == DATA_TYPE_INT8 && input->get_dtype() == DATA_TYPE_INT8) {
+        base::requantize_linear<int8_t, int8_t>(&args[0]);
+    } else if (output->get_dtype() == DATA_TYPE_INT8 && input->get_dtype() == DATA_TYPE_INT16) {
+        base::requantize_linear<int8_t, int16_t>(&args[0]);
+    } else if (output->get_dtype() == DATA_TYPE_INT16 && input->get_dtype() == DATA_TYPE_INT16) {
+        base::requantize_linear<int16_t, int16_t>(&args[0]);
+    } else if (output->get_dtype() == DATA_TYPE_INT16 && input->get_dtype() == DATA_TYPE_INT8) {
+        base::requantize_linear<int16_t, int8_t>(&args[0]);
+    } else {
+        return false;
+    }
+    return true;
+}
+#endif
