+static int32_t round_half_even_ratio(int32_t value, int32_t numerator, int32_t denominator)
+{
+    int32_t product = value * numerator;
+    bool negative = product < 0;
+    uint32_t magnitude = static_cast<uint32_t>(negative ? -product : product);
+    uint32_t quotient = magnitude / static_cast<uint32_t>(denominator);
+    uint32_t remainder = magnitude % static_cast<uint32_t>(denominator);
+    uint32_t twice_remainder = remainder * 2;
+    if (twice_remainder > static_cast<uint32_t>(denominator) ||
+        (twice_remainder == static_cast<uint32_t>(denominator) && (quotient & 1u))) {
+        ++quotient;
+    }
+    return negative ? -static_cast<int32_t>(quotient) : static_cast<int32_t>(quotient);
