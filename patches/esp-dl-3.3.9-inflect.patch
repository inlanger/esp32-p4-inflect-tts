+#if defined(INFLECT_RUNTIME_COPY_K3_MERGES)
+void Model::configure_runtime_k3_merge_copy()
+{
+    const std::string subgraph = m_fbs_model->get_model_metadata_prop("subgraph");
+    if (!subgraph.starts_with("decoder.")) {
+        return;
+    }
+
+    int merge_modules = 0;
+    assert(m_execution_names.size() == m_execution_plan.size());
+    for (size_t i = 0; i < m_execution_plan.size(); ++i) {
+        const char *name = m_execution_names[i].c_str();
+        if (!is_first_stage_merge(name)) {
+            continue;
+        }
+
+        dl::module::Module *module = m_execution_plan[i];
+        assert(module->m_inputs_index.size() == 2);
+        assert(module->m_outputs_index.size() == 1);
+        TensorBase *removed = m_model_context->get_tensor(module->m_inputs_index[0]);
+        TensorBase *retained = m_model_context->get_tensor(module->m_inputs_index[1]);
+        TensorBase *output = m_model_context->get_tensor(module->m_outputs_index[0]);
+        if (removed == nullptr || retained == nullptr || output == nullptr || removed->get_element_ptr() == nullptr ||
+            retained->get_element_ptr() == nullptr || output->get_element_ptr() == nullptr) {
+            ESP_LOGE(TAG, "Missing tensor storage for pruned k3 merge %s", name);
+            assert(false);
+            return;
+        }
+        const uintptr_t output_begin = reinterpret_cast<uintptr_t>(output->get_element_ptr());
+        const uintptr_t retained_begin = reinterpret_cast<uintptr_t>(retained->get_element_ptr());
+        const uintptr_t output_end = output_begin + output->get_bytes();
+        const uintptr_t retained_end = retained_begin + retained->get_bytes();
+        const bool non_overlapping = output_end <= retained_begin || retained_end <= output_begin;
+        const bool valid = output->get_element_ptr() == removed->get_element_ptr() && non_overlapping &&
+            removed->get_size() == output->get_size() && removed->get_bytes() == output->get_bytes() &&
+            removed->get_dtype() == output->get_dtype() && removed->get_exponent() == output->get_exponent() &&
+            removed->get_shape() == output->get_shape() && retained->get_size() == output->get_size() &&
+            retained->get_bytes() == output->get_bytes() && retained->get_dtype() == output->get_dtype() &&
+            retained->get_exponent() == output->get_exponent() && retained->get_shape() == output->get_shape();
+        if (!valid) {
+            ESP_LOGE(TAG, "Cannot replace pruned k3 merge %s with direct copy", name);
+            assert(false);
+            return;
+        }
+        ++merge_modules;
+    }
+
+    if (merge_modules != 4) {
+        ESP_LOGE(TAG, "Unexpected decoder topology for k3 merge copy: merge=%d", merge_modules);
+        assert(false);
+        return;
+    }
+    m_runtime_copy_k3_merges = true;
+    ESP_LOGI(TAG, "Enabled direct P4 copy for pruned k3 merges in %s: merge=%d", subgraph.c_str(), merge_modules);
+}
+#endif
