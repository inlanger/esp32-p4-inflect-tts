+#if defined(INFLECT_RUNTIME_PRUNE_K3)
+void Model::configure_runtime_k3_pruning()
+{
+    const std::string subgraph = m_fbs_model->get_model_metadata_prop("subgraph");
+    if (!subgraph.starts_with("decoder.")) {
+        return;
+    }
+
+    int skipped_modules = 0;
+    int merge_modules = 0;
+    int div_modules = 0;
+#if defined(INFLECT_RUNTIME_PRUNE_K7_TAIL)
+    int skipped_k7_tail_modules = 0;
+    int k7_tail_merge_modules = 0;
+#if defined(INFLECT_RUNTIME_PRUNE_K7_SECOND)
+    int skipped_k7_second_modules = 0;
+    int k7_second_merge_modules = 0;
+#endif
+#endif
+    assert(m_execution_names.size() == m_execution_plan.size());
+    for (size_t i = 0; i < m_execution_plan.size(); ++i) {
+        dl::module::Module *module = m_execution_plan[i];
+        const char *name = m_execution_names[i].c_str();
+        if (is_k3_module(name)) {
+            ++skipped_modules;
+        } else if (is_first_stage_merge(name)) {
+            ++merge_modules;
+        } else if (is_stage_div(name)) {
+            ++div_modules;
+            assert(module->m_inputs_index.size() == 2);
+            TensorBase *divisor = m_model_context->get_tensor(module->m_inputs_index[1]);
+            if (!m_fbs_model->m_param_copy || !rewrite_divisor_to_two(divisor)) {
+                ESP_LOGE(TAG, "Cannot rewrite %s divisor from 3 to 2", name);
+                assert(false);
+            }
+        }
+#if defined(INFLECT_RUNTIME_PRUNE_K7_TAIL)
+        if (is_k7_tail_module(name)) {
+            ++skipped_k7_tail_modules;
+        } else if (is_k7_tail_merge(name)) {
+            ++k7_tail_merge_modules;
+            assert(module->m_inputs_index.size() == 2);
+            assert(module->m_outputs_index.size() == 1);
+            assert(module->m_inputs_index[0] != module->m_inputs_index[1]);
+        }
+#if defined(INFLECT_RUNTIME_PRUNE_K7_SECOND)
+        if (is_k7_second_module(name)) {
+            ++skipped_k7_second_modules;
+        } else if (is_k7_second_merge(name)) {
+            ++k7_second_merge_modules;
+            assert(module->m_inputs_index.size() == 2);
+            assert(module->m_outputs_index.size() == 1);
+            assert(module->m_inputs_index[0] != module->m_inputs_index[1]);
+        }
+#endif
+#endif
+    }
+
+    if (skipped_modules != 60 || merge_modules != 4 || div_modules != 4) {
+        ESP_LOGE(TAG,
+                 "Unexpected decoder topology for k3 pruning: skip=%d merge=%d div=%d",
+                 skipped_modules,
+                 merge_modules,
+                 div_modules);
+        assert(false);
+    }
+    m_runtime_prune_k3 = true;
+    ESP_LOGI(TAG,
+             "Enabled same-package k3 pruning for %s: skip=%d merge=%d div=%d",
+             subgraph.c_str(),
+             skipped_modules,
+             merge_modules,
+             div_modules);
+#if defined(INFLECT_RUNTIME_PRUNE_K7_TAIL)
+    if (skipped_k7_tail_modules != 16 || k7_tail_merge_modules != 4) {
+        ESP_LOGE(TAG,
+                 "Unexpected decoder topology for k7 tail pruning: skip=%d merge=%d",
+                 skipped_k7_tail_modules,
+                 k7_tail_merge_modules);
+        assert(false);
+    }
+    ESP_LOGI(TAG,
+             "Enabled same-package k7 tail pruning for %s: skip=%d merge=%d",
+             subgraph.c_str(),
+             skipped_k7_tail_modules,
+             k7_tail_merge_modules);
+#if defined(INFLECT_RUNTIME_PRUNE_K7_SECOND)
+    if (skipped_k7_second_modules != 16 || k7_second_merge_modules != 4) {
+        ESP_LOGE(TAG,
+                 "Unexpected decoder topology for k7 second pruning: skip=%d merge=%d",
+                 skipped_k7_second_modules,
+                 k7_second_merge_modules);
+        assert(false);
+    }
+    ESP_LOGI(TAG,
+             "Enabled same-package k7 second pruning for %s: skip=%d merge=%d",
+             subgraph.c_str(),
+             skipped_k7_second_modules,
+             k7_second_merge_modules);
+#endif
+#endif
+}
+#endif
