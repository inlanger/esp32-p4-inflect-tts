+bool Model::forward_module(size_t execution_index, runtime_mode_t mode)
+{
+    dl::module::Module *module = m_execution_plan[execution_index];
+#if defined(INFLECT_RUNTIME_PRUNE_K3)
+    if (m_runtime_prune_k3) {
+        const char *name = m_execution_names[execution_index].c_str();
+#if defined(INFLECT_RUNTIME_COPY_K3_MERGES)
+        if (m_runtime_copy_k3_merges && is_first_stage_merge(name)) {
+            TensorBase *retained = m_model_context->get_tensor(module->m_inputs_index[1]);
+            TensorBase *output = m_model_context->get_tensor(module->m_outputs_index[0]);
+            tool::copy_memory(output->get_element_ptr(), retained->get_element_ptr(), output->get_bytes());
+            return true;
+        }
+#endif
+#if defined(INFLECT_RUNTIME_BYPASS_K7_MERGES)
+        if (m_runtime_bypass_k7_merges && is_pruned_k7_merge(name)) {
+            return true;
+        }
+#endif
+        if (is_k3_module(name)) {
+            return false;
+        }
+        if (is_first_stage_merge(name)) {
+            assert(module->m_inputs_index.size() == 2);
+            TensorBase *skipped_output = m_model_context->get_tensor(module->m_inputs_index[0]);
+            assert(skipped_output != nullptr);
+            tool::set_zero(skipped_output->get_element_ptr(), skipped_output->get_bytes());
+        }
+#if defined(INFLECT_RUNTIME_PRUNE_K7_TAIL)
+        if (is_k7_tail_module(name)) {
+            return false;
+        }
+        if (is_k7_tail_merge(name)) {
+            assert(module->m_inputs_index.size() == 2);
+            TensorBase *identity = m_model_context->get_tensor(module->m_inputs_index[0]);
+            TensorBase *skipped_residual = m_model_context->get_tensor(module->m_inputs_index[1]);
+            assert(identity != nullptr);
+            assert(skipped_residual != nullptr);
+            assert(identity->get_size() == skipped_residual->get_size());
+            assert(identity->get_dtype() == skipped_residual->get_dtype());
+            assert(identity->get_element_ptr() != skipped_residual->get_element_ptr());
+            tool::set_zero(skipped_residual->get_element_ptr(), skipped_residual->get_bytes());
+        }
+#if defined(INFLECT_RUNTIME_PRUNE_K7_SECOND)
+        if (is_k7_second_module(name)) {
+            return false;
+        }
+        if (is_k7_second_merge(name)) {
+            assert(module->m_inputs_index.size() == 2);
+            TensorBase *identity = m_model_context->get_tensor(module->m_inputs_index[0]);
+            TensorBase *skipped_residual = m_model_context->get_tensor(module->m_inputs_index[1]);
+            assert(identity != nullptr);
+            assert(skipped_residual != nullptr);
+            assert(identity->get_size() == skipped_residual->get_size());
+            assert(identity->get_dtype() == skipped_residual->get_dtype());
+            assert(identity->get_element_ptr() != skipped_residual->get_element_ptr());
+            tool::set_zero(skipped_residual->get_element_ptr(), skipped_residual->get_bytes());
+        }
+#endif
+#endif
+#if defined(INFLECT_RUNTIME_DIV2_REQUANT)
+        if (is_stage_div(name)) {
+            assert(module->m_inputs_index.size() == 2);
+            assert(module->m_outputs_index.size() == 1);
+            TensorBase *input = m_model_context->get_tensor(module->m_inputs_index[0]);
+            TensorBase *output = m_model_context->get_tensor(module->m_outputs_index[0]);
+            if (!requantize_divide_by_two(output, input, mode)) {
+                ESP_LOGE(TAG, "Cannot replace %s with divide-by-two requantization", name);
+                assert(false);
+            }
+            return true;
+        }
+#endif
+    }
+#endif
+    module->forward(m_model_context, mode);
+    return true;
+}
